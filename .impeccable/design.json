      "kind": "input",
      "refersTo": "input",
      "description": "Manual numeric entry with an explicit unit.",
      "html": "<label class=\"ds-field-label\" for=\"ds-price\">Current quote</label><div class=\"ds-field\"><input id=\"ds-price\" inputmode=\"decimal\" placeholder=\"0.00\" aria-label=\"Current quote in BRL\"><span>BRL</span></div>",
      "css": ".ds-field-label{display:block;font-size:11px;font-weight:550;margin-bottom:7px;color:var(--ink);font-family:\"DM Sans Variable\",sans-serif;}.ds-field{display:flex;align-items:center;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--background);min-height:43px;padding:0 12px;transition:border-color 150ms ease;}.ds-field:hover{border-color:var(--scroll-thumb);}.ds-field:focus-within{border-color:var(--primary);outline:2px solid var(--tint);}.ds-field input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);padding:11px 0;font-size:13px;caret-color:var(--primary);font-variant-numeric:tabular-nums;font-family:\"DM Sans Variable\",sans-serif;}.ds-field input::placeholder{color:var(--muted);opacity:1;}.ds-field span{font-size:10px;color:var(--muted);white-space:nowrap;margin-left:8px;font-family:\"DM Sans Variable\",sans-serif;}@media(prefers-reduced-motion:reduce){*{transition:none!important;}}"
    },
