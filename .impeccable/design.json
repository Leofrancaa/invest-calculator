      "css": ".ds-button-secondary{border-radius:var(--radius-control);min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;font-size:11px;font-weight:550;transition:background 150ms ease;cursor:pointer;font-family:\"DM Sans Variable\",sans-serif;border:1px solid var(--line);background:var(--surface);color:var(--ink);}.ds-button-secondary:hover{background:var(--tint);}.ds-button-secondary:focus-visible{outline:3px solid var(--primary);outline-offset:4px;}.ds-button-secondary:active{transform:translateY(1px);}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){*{transition:none!important;}}"
    },
