      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Save a comparison snapshot.",
      "html": "<button class=\"ds-button-primary\">Save comparison</button>",
      "css": ".ds-button-primary{border-radius:var(--radius-control);min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;font-size:11px;font-weight:550;transition:background 150ms ease;cursor:pointer;font-family:\"DM Sans Variable\",sans-serif;border:0;background:var(--primary);color:var(--surface);}.ds-button-primary:hover{background:var(--primary-hover);}.ds-button-primary:focus-visible{outline:3px solid var(--primary);outline-offset:4px;}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){*{transition:none!important;}}"
    },
